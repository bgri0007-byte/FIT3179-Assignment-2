{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Interactive map of Manningham playgrounds, coloured and filtered by playground classification.",
  "width": "container",
  "height": 500,
  "projection": {
    "type": "mercator"
  },
  "params": [
    {
      "name": "selectedClassification",
      "value": "All playgrounds",
      "bind": {
        "input": "select",
        "name": "Show: ",
        "options": [
          "All playgrounds",
          "Small Playground",
          "Large Playground",
          "District Playground",
          "Regional Playground"
        ]
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/manningham_boundary.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e5e7eb",
        "stroke": "#ffffff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/playgrounds_combined_manningham.csv"
      },
      "transform": [
        {
          "filter": "datum.council === 'Manningham'"
        },
        {
          "filter": "selectedClassification === 'All playgrounds' || datum.classification === selectedClassification"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 50,
        "opacity": 0.9,
        "stroke": "#ffffff",
        "strokeWidth": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "color": {
          "field": "classification",
          "type": "nominal",
          "title": "Playground classification",
          "scale": {
            "domain": [
              "Small Playground",
              "Large Playground",
              "District Playground",
              "Regional Playground"
            ],
            "range": ["#4477AA", "#D8A24C", "#AA4499", "#66CCEE"]
          },
          "legend": {
            "orient": "top-left",
            "direction": "vertical",
            "title": "Playground classification",
            "titleFont": "Segoe UI",
            "titleFontSize": 14,
            "titleFontWeight": "bold",
            "titleColor": "#173D32",
            "titlePadding": 12,
            "labelFont": "Segoe UI",
            "labelFontSize": 13,
            "labelColor": "#334155",
            "symbolType": "circle",
            "symbolSize": 140,
            "symbolStrokeColor": "#FFFFFF",
            "symbolStrokeWidth": 0.8,
            "rowPadding": 8,
            "padding": 12,
            "offset": 12
          }
        },
        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "Playground"
          },
          {
            "field": "council",
            "type": "nominal",
            "title": "Council"
          },
          {
            "field": "suburb",
            "type": "nominal",
            "title": "Suburb"
          },
          {
            "field": "classification",
            "type": "nominal",
            "title": "Classification"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
