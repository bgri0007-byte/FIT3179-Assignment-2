{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Australian playground study regions with linked selection highlighting.",
  "width": "container",
  "height": 430,
  "params": [
    {
      "name": "selectedRegion",
      "value": ""
    }
  ],
  "projection": {
    "type": "mercator",
    "center": [143, -38],
    "scale": 1400
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states_optimised.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e5e7eb",
        "stroke": "#ffffff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "values": [
          {
            "region": "Greater Melbourne",
            "regions": "Melbourne, Manningham, Greater Dandenong",
            "datasets": "Melbourne, Manningham, Greater Dandenong",
            "longitude": 144.96332,
            "latitude": -37.814
          },
          {
            "region": "ACT",
            "regions": "ACT",
            "datasets": "ACT Government",
            "longitude": 149.12807,
            "latitude": -35.28346
          },
          {
            "region": "Adelaide",
            "regions": "Adelaide",
            "datasets": "City of Adelaide",
            "longitude": 138.59863,
            "latitude": -34.92866
          },
          {
            "region": "Hobart",
            "regions": "Hobart",
            "datasets": "City of Hobart",
            "longitude": 147.32941,
            "latitude": -42.87936
          },
          {
            "region": "Greater Shepparton",
            "regions": "Greater Shepparton",
            "datasets": "Greater Shepparton City Council",
            "longitude": 145.39867,
            "latitude": -36.38047
          }
        ]
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "size": 190,
            "stroke": "#ffffff",
            "strokeWidth": 1.8,
            "cursor": "pointer"
          },
          "encoding": {
            "color": {
              "condition": {
                "test": "selectedRegion === '' || datum.region === selectedRegion || (datum.region === 'Greater Melbourne' && indexof(['Melbourne', 'Manningham', 'Greater Dandenong'], selectedRegion) >= 0)",
                "value": "#2878B5"
              },
              "value": "#b8c1c8"
            },
            "opacity": {
              "condition": {
                "test": "selectedRegion === '' || datum.region === selectedRegion || (datum.region === 'Greater Melbourne' && indexof(['Melbourne', 'Manningham', 'Greater Dandenong'], selectedRegion) >= 0)",
                "value": 1
              },
              "value": 0.35
            },
            "tooltip": [
              {
                "field": "region",
                "type": "nominal",
                "title": "Study region"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dx": 14,
            "fontSize": 15,
            "fontWeight": "bold",
            "color": "#263f35",
            "cursor": "pointer"
          },
          "encoding": {
            "text": {
              "field": "region",
              "type": "nominal"
            },
            "opacity": {
              "condition": {
                "test": "selectedRegion === '' || datum.region === selectedRegion || (datum.region === 'Greater Melbourne' && indexof(['Melbourne', 'Manningham', 'Greater Dandenong'], selectedRegion) >= 0)",
                "value": 1
              },
              "value": 0.3
            },
            "tooltip": [
              {
                "field": "region",
                "type": "nominal",
                "title": "Study region"
              }
            ]
          }
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "text": {
      "font": "Arial"
    }
  }
}
