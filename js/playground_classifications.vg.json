{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Horizontal bar chart comparing the number of playgrounds in each Manningham classification.",

  "width": "container",
  "height": 250,

  "data": {
    "url": "data/playgrounds_combined_manningham.csv"
  },

  "transform": [
    {
      "filter": "datum.council === 'Manningham'"
    }
  ],

  "mark": {
    "type": "bar"
  },

  "encoding": {
    "x": {
      "aggregate": "count",
      "type": "quantitative",
      "title": "Number of playgrounds"
    },

    "y": {
      "field": "classification",
      "type": "nominal",
      "title": "Playground classification",
      "sort": "-x"
    },

    "tooltip": [
      {
        "field": "classification",
        "type": "nominal",
        "title": "Playground type"
      },
      {
        "aggregate": "count",
        "type": "quantitative",
        "title": "Number of playgrounds"
      }
    ]
  }
}
