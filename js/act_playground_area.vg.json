{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional-symbol map of Canberra playgrounds, with interactive highlighting by surface-area range.",

  "width": "container",
  "height": 550,

  "projection": {
    "type": "mercator",
    "center": [149.13, -35.3],
    "scale": 55000
  },

  "params": [
    {
      "name": "selectedArea",
      "value": "All playground sizes",
      "bind": {
        "input": "select",
        "name": "Surface area: ",
        "options": [
          "All playground sizes",
          "Under 200 m²",
          "200–400 m²",
          "400–800 m²",
          "800–1,600 m²",
          "Over 1,600 m²"
        ]
      }
    }
  ],

  "layer": [
    {
      "data": {
        "url": "data/australia_states_optimised.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "transform": [
        {
          "window": [
            {
              "op": "row_number",
              "as": "feature_index"
            }
          ]
        },
        {
          "filter": "datum.feature_index === 8"
        }
      ],

      "mark": {
        "type": "geoshape",
        "fill": "#F1F5F9",
        "stroke": "#94A3B8",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/playgrounds_combined_act.csv"
      },

      "transform": [
        {
          "filter": "datum.council === 'ACT'"
        },
        {
          "calculate": "toNumber(datum.surface_area)",
          "as": "area_m2"
        },
        {
          "filter": "isValid(datum.area_m2) && datum.area_m2 > 0"
        },
        {
          "calculate": "selectedArea === 'All playground sizes' || (selectedArea === 'Under 200 m²' && datum.area_m2 < 200) || (selectedArea === '200–400 m²' && datum.area_m2 >= 200 && datum.area_m2 < 400) || (selectedArea === '400–800 m²' && datum.area_m2 >= 400 && datum.area_m2 < 800) || (selectedArea === '800–1,600 m²' && datum.area_m2 >= 800 && datum.area_m2 < 1600) || (selectedArea === 'Over 1,600 m²' && datum.area_m2 >= 1600)",
          "as": "isSelected"
        }
      ],

      "mark": {
        "type": "circle",
        "opacity": 0.75,
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "color": {
          "condition": {
            "test": "datum.isSelected",
            "value": "#4477AA"
          },
          "value": "#D5DAD8"
        },

        "size": {
          "field": "area_m2",
          "type": "quantitative",
          "title": "Playground surface area (m²)",
          "scale": {
            "type": "linear",
            "range": [20, 700]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": "Playground surface area (m²)",
            "values": [250, 750, 1500, 2500, 3300],
            "format": ",.0f",
            "symbolType": "circle",
            "symbolFillColor": "#4477AA",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "offset": 15
          }
        },

        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "Playground"
          },
          {
            "field": "suburb",
            "type": "nominal",
            "title": "Suburb"
          },
          {
            "field": "area_m2",
            "type": "quantitative",
            "title": "Surface area (m²)",
            "format": ",.0f"
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    }
  }
}
