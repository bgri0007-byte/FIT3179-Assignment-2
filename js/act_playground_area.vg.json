{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Responsive proportional-symbol map of Canberra playgrounds with interactive surface-area filtering.",
  "width": "container",
  "height": 470,
  "background": null,
  "projection": {
    "type": "mercator",
    "center": [149.13, -35.3],
    "scale": 55000
  },
  "params": [
    {
      "name": "selectedArea",
      "value": "All playground sizes",
      "bind": {
        "input": "select",
        "name": "FILTER BY SIZE",
        "options": [
          "All playground sizes",
          "Under 200 m²",
          "200–400 m²",
          "400–800 m²",
          "800–1,600 m²",
          "Over 1,600 m²"
        ]
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/australia_states_optimised.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "window": [
            {
              "op": "row_number",
              "as": "feature_index"
            }
          ]
        },
        {
          "filter": "datum.feature_index === 8"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#F1F5F9",
        "stroke": "#94A3B8",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/playgrounds_combined_act.csv"
      },
      "transform": [
        {
          "filter": "datum.council === 'ACT'"
        },
        {
          "calculate": "toNumber(datum.surface_area)",
          "as": "area_m2"
        },
        {
          "filter": "isValid(datum.area_m2) && datum.area_m2 > 0"
        },
        {
          "filter": "selectedArea === 'All playground sizes' || (selectedArea === 'Under 200 m²' && datum.area_m2 < 200) || (selectedArea === '200–400 m²' && datum.area_m2 >= 200 && datum.area_m2 < 400) || (selectedArea === '400–800 m²' && datum.area_m2 >= 400 && datum.area_m2 < 800) || (selectedArea === '800–1,600 m²' && datum.area_m2 >= 800 && datum.area_m2 < 1600) || (selectedArea === 'Over 1,600 m²' && datum.area_m2 >= 1600)"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#4477AA",
        "opacity": 0.85,
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "area_m2",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [0, 3300],
            "range": [20, 700],
            "clamp": true,
            "zero": true
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "Playground"
          },
          {
            "field": "suburb",
            "type": "nominal",
            "title": "Suburb"
          },
          {
            "field": "area_m2",
            "type": "quantitative",
            "title": "Surface area (m²)",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
